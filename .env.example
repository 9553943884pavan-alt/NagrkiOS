# TEMPLATE ONLY: never put real passwords, connection URLs or API keys here.
# For local use, copy this file to Git-ignored backend/.env and load that file
# into the process environment before starting FastAPI or a local migration.
# The app does not auto-load .env, and GitHub Actions cannot read backend/.env.
# Explicit local development mode enables synthetic seed users.
NAGRIKOS_MODE=demo
# DATABASE_PATH can be omitted to use backend/data/nagrikos.db.
# Use the pooled URL for DATABASE_URL and the direct, pooling-off URL for
# DIRECT_URL from the SAME intended Neon branch. Both need sslmode=require.
# Production URLs in a local backend/.env make local processes target production;
# set NAGRIKOS_MODE=public and all public-mode controls before starting FastAPI.
# For the manual GitHub schema workflow, separately add both complete URLs as
# Environment secrets under repository Settings > Environments > neon-schema.
# A local backend/.env is never uploaded to GitHub Actions automatically.
# Render runtime needs only its pooled DATABASE_URL; Vercel needs neither URL.
DATABASE_URL=
DIRECT_URL=
PUBLIC_BASE_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false

# For Render public mode: set NAGRIKOS_MODE=public, COOKIE_SECURE=true,
# PUBLIC_BASE_URL and CORS_ORIGINS to the exact Vercel HTTPS origin, and
# configure a persistent NAGRIKOS_TOTP_KEY and Mailjet HTTPS email delivery.
# Vercel needs only NAGRIKOS_RENDER_ORIGIN (the Render HTTPS origin) for its
# /api rewrite; leave VITE_API_BASE unset. See docs/RENDER_VERCEL_DEPLOYMENT.md.
# Set MAILJET_API_KEY, MAILJET_SECRET_KEY and MAIL_FROM as backend secrets.
# MAIL_FROM must be an active sender address validated in Mailjet.
# Generate the key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NAGRIKOS_TOTP_KEY=
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAIL_FROM=

# Optional local development: leave storage unset to use backend/uploads.
# Public deployment requires a verified private bucket. Storage is in the
# separate Neon Singapore project cold-violet-69814991; PostgreSQL stays in
# the Sydney project winter-meadow-40329605. Never paste storage credentials
# into DATABASE_URL or DIRECT_URL, or database credentials into AWS_*.
# For Neon storage, set OBJECT_STORAGE_BACKEND=neon and copy the AWS_* values
# for ONE branch only from that branch's Neon Console credentials. Testing:
# https://br-lively-base-azf2mt0j.storage.c-3.ap-southeast-1.aws.neon.tech
# Production (private bucket and credentials provisioned; live writes untested):
# https://br-divine-grass-azierqs7.storage.c-3.ap-southeast-1.aws.neon.tech
# Both use OBJECT_STORAGE_BUCKET=nagrikos-attachments and AWS_REGION=ap-southeast-1.
# Keep all entries blank until the chosen branch is ready; partial config fails.
# The legacy OBJECT_STORAGE_* S3 credential names remain supported only when
# OBJECT_STORAGE_BACKEND is unset or "s3"; never mix both credential sets.
NAGRIKOS_REQUIRE_DURABLE_STORAGE=false
OBJECT_STORAGE_BACKEND=
OBJECT_STORAGE_BUCKET=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Legacy S3-compatible provider settings (leave blank for Neon storage).
OBJECT_STORAGE_ENDPOINT_URL=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

# Testing-branch migration guard. Copy exact direct endpoint hostnames from the
# Neon Console branch Connect dialogs. Hostname only: no scheme, credentials,
# database name, port, or query string. Add both as separate neon-schema
# Environment secrets in GitHub. For a LOCAL preflight, they may also be set
# in backend/.env and loaded into that terminal's process environment.
NEON_TESTING_DIRECT_HOST=
NEON_PRODUCTION_DIRECT_HOST=
# Add the testing branch ID (br-...) as NEON_TESTING_BRANCH_ID in the SAME
# protected GitHub neon-schema environment. The workflow asks you to enter it
# again when manually triggered. It also asks for the READY backup branch ID
# as a separate workflow input; this is not a sixth environment secret.
# Do not run that workflow before explicit approval for the testing-branch
# write and a recoverable rollback point.

# Historical production migration guard names. The initial production schema
# is already migrated; no initial-schema workflow is included in this release.
# Future schema changes require a separately reviewed, approved procedure.
# NEON_API_KEY is a Sydney-project Management API key, never a PostgreSQL or
# Singapore Object Storage credential. Leave all values blank in this file.
NEON_PRODUCTION_PROJECT_ID=
NEON_PRODUCTION_BRANCH_ID=
NEON_PRODUCTION_BACKUP_BRANCH_ID=
NEON_API_KEY=
