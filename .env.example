# Copy values into your process environment; the app does not auto-load this file.
# Explicit local development mode enables synthetic seed users and the local mail sink.
NAGRIKOS_MODE=demo
# DATABASE_PATH can be omitted to use backend/data/nagrikos.db.
PUBLIC_BASE_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false

# For public mode: set NAGRIKOS_MODE=public, COOKIE_SECURE=true, an HTTPS
# PUBLIC_BASE_URL, a persistent NAGRIKOS_TOTP_KEY, and working SMTP settings.
# Generate the key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NAGRIKOS_TOTP_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
