# Copy values into your process environment; the app does not auto-load this file.
# Explicit local development mode enables synthetic seed users.
NAGRIKOS_MODE=demo
# DATABASE_PATH can be omitted to use backend/data/nagrikos.db.
# For Neon public deployment, use the pooled URL from the branch Connect dialog.
# Run Alembic and SQLite import with the unpooled URL from the same branch.
# Keep both values only in backend/.env or a deployment secret store, never in Git.
DATABASE_URL=
DIRECT_URL=
PUBLIC_BASE_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false

# For Render public mode: set NAGRIKOS_MODE=public, COOKIE_SECURE=true,
# PUBLIC_BASE_URL and CORS_ORIGINS to the exact Vercel HTTPS origin, and
# configure a persistent NAGRIKOS_TOTP_KEY and Brevo email delivery.
# Vercel needs only NAGRIKOS_RENDER_ORIGIN (the Render HTTPS origin) for its
# /api rewrite; leave VITE_API_BASE unset. See docs/RENDER_VERCEL_DEPLOYMENT.md.
# Set BREVO_API_KEY and MAIL_FROM as backend secrets; never use VITE_ variables.
# MAIL_FROM must be an approved sender address in your Brevo account.
# Generate the key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NAGRIKOS_TOTP_KEY=
BREVO_API_KEY=
MAIL_FROM=
